# PostgreSQL connection string (postgresql+psycopg2://user:password@host:port/dbname)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/crowdshield

# PostgreSQL connection string for the dedicated test database (used by backend/tests/conftest.py)
DATABASE_URL_TEST=postgresql+psycopg2://user:password@localhost:5432/crowdshield_test

# Secret key used by Auth.js (frontend) to encrypt/sign its own session — NOT used by the backend
AUTH_SECRET=changeme

# Secret key used by FastAPI to sign/verify its own JWTs. Independent of AUTH_SECRET — never reuse
# Auth.js's secret here. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=changeme

# Minutes until a FastAPI-issued JWT access token expires
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Public URL of the Next.js frontend, used by Auth.js
NEXTAUTH_URL=http://localhost:3000

# Filesystem path where uploaded/processed video files are stored
VIDEO_STORAGE_PATH=storage/videos

# Maximum accepted video upload size, in megabytes. Enforced while streaming
# to disk (not just via Content-Length), so oversized uploads are aborted and
# the partial file deleted before this limit is exceeded.
MAX_UPLOAD_SIZE_MB=2048

# Application log verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Name/identifier of the object detection model used by the pipeline
DETECTOR_MODEL=yolo11n

# Inference backend for the detector: "pytorch" is the only implemented
# value; "openvino" is deferred to roadmap Phase 23 (CPU optimization) and
# will raise a clear configuration error if set today. Note: this does NOT
# select the compute device — YOLO11nDetector always forces CPU inference
# regardless of this setting (master spec §5's CPU-first constraint).
DETECTOR_RUNTIME=pytorch

# Minimum confidence for a detection to be kept, passed directly to
# ultralytics' conf= inference parameter (also governs its internal NMS).
# 0.25 matches ultralytics' own library default.
DETECTOR_CONFIDENCE_THRESHOLD=0.25

# Name/identifier of the vision-language model used for scene analysis
VLM_MODEL=placeholder-vlm

# Name/identifier of the large language model used for decision support
LLM_MODEL=placeholder-llm

# Crowd density/risk score threshold that triggers an "elevated" status
RISK_ELEVATED_THRESHOLD=0.5

# Crowd density/risk score threshold that triggers a "critical" status
RISK_CRITICAL_THRESHOLD=0.75

# Crowd density/risk score threshold that triggers an "incident" status
RISK_INCIDENT_THRESHOLD=0.9

# Minimum seconds between consecutive VLM analysis calls
VLM_COOLDOWN=30

# Seconds between fallback (non-VLM) analysis passes when VLM is unavailable
FALLBACK_ANALYSIS_INTERVAL=60

# JSON array of allowed CORS origins for the backend API
CORS_ORIGINS=["http://localhost:3000"]
