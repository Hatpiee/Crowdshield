# PostgreSQL connection string (postgresql+psycopg2://user:password@host:port/dbname)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/crowdshield

# PostgreSQL connection string for the dedicated test database (used by backend/tests/conftest.py)
DATABASE_URL_TEST=postgresql+psycopg2://user:password@localhost:5432/crowdshield_test

# Secret key used by Auth.js (frontend) to encrypt/sign its own session — NOT used by the backend
AUTH_SECRET=changeme

# Secret key used by FastAPI to sign/verify its own JWTs. Independent of AUTH_SECRET — never reuse
# Auth.js's secret here. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=changeme

# Minutes until a FastAPI-issued JWT access token expires
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Public URL of the Next.js frontend, used by Auth.js
NEXTAUTH_URL=http://localhost:3000

# Filesystem path where uploaded/processed video files are stored
VIDEO_STORAGE_PATH=storage/videos

# Maximum accepted video upload size, in megabytes. Enforced while streaming
# to disk (not just via Content-Length), so oversized uploads are aborted and
# the partial file deleted before this limit is exceeded.
MAX_UPLOAD_SIZE_MB=2048

# Application log verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Name/identifier of the object detection model used by the pipeline
DETECTOR_MODEL=yolo11n

# Inference backend for the detector: "pytorch" is the only implemented
# value; "openvino" is deferred to roadmap Phase 23 (CPU optimization) and
# will raise a clear configuration error if set today. Note: this does NOT
# select the compute device — YOLO11nDetector always forces CPU inference
# regardless of this setting (master spec §5's CPU-first constraint).
DETECTOR_RUNTIME=pytorch

# Minimum confidence for a detection to be kept, passed directly to
# ultralytics' conf= inference parameter (also governs its internal NMS).
# 0.25 matches ultralytics' own library default.
DETECTOR_CONFIDENCE_THRESHOLD=0.25

# How many of a track's most recent positions are kept in memory per track
# (bounded history, ~1s at 30fps). May need retuning once the Crowd
# Intelligence Engine's actual velocity-variance windowing needs are known.
TRACK_HISTORY_LENGTH=30

# trackers.ByteTrackTracker's lost_track_buffer: number of 30fps-equivalent
# frames a track is retained after going unmatched before being permanently
# removed. 30 is the library's own default.
TRACKER_LOST_TRACK_BUFFER=30

# trackers.ByteTrackTracker's minimum_consecutive_frames: number of
# consecutive matched frames required before a new track is confirmed (given
# a stable track_id instead of the library's placeholder -1). 2 is the
# library's own default.
TRACKER_MINIMUM_CONSECUTIVE_FRAMES=2

# trackers.ByteTrackTracker's track_activation_threshold: minimum detection
# confidence required to CREATE a new track (distinct from
# DETECTOR_CONFIDENCE_THRESHOLD, which gates what counts as a detection at
# all). The library's own general-purpose default is 0.7, but real-footage
# testing found that most real detections from YOLO11nDetector (tuned to
# 0.25 for recall) never clear 0.7, so almost no one gets a confirmed
# track_id at that default in dense/aerial scenes.
#
# UNVALIDATED ENGINEERING JUDGMENT (not empirically tuned against real
# crowd footage, candidate for Sprint-0 recalibration — see DECISIONS.md):
# 0.3, chosen just above DETECTOR_CONFIDENCE_THRESHOLD's 0.25 floor.
TRACKER_TRACK_ACTIVATION_THRESHOLD=0.3

# Which cv2.DISOpticalFlow_create preset to use: "ultrafast", "fast", or
# "medium" (mapped to the real cv2.DISOPTICAL_FLOW_PRESET_* constants).
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): "fast", a balance between quality and CPU cost per §5's
# own "~21-48 FPS depending on preset" citation; not benchmarked on this
# project's target hardware.
DIS_PRESET=fast

# Flow-magnitude floor (pixels) below which a pixel is excluded from this
# phase's whole-frame summary statistics only — the raw flow field itself is
# never filtered.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 0.5.
MOTION_MAGNITUDE_NOISE_FLOOR=0.5

# Pixels per square grid cell edge for the shared spatial grid Density and
# Flow are both computed on (so Crowd Pressure can combine them pointwise
# without interpolation). Grid rows/cols are derived from frame width/height
# divided by this value.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 40, not calibrated against any real venue's physical
# scale (this project has no camera calibration — see DECISIONS.md's "Known
# Structural Limitation: Pixel-Space vs. Real-World Units" section).
CROWD_GRID_CELL_SIZE_PX=40

# Density (people/cell) threshold above which a cell counts as "dense" for
# Congestion — used ONLY in combination with the flow-magnitude threshold
# below (density alone never triggers congestion; frozen decision).
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 0.1, informed by real observed density values from
# Phase 9's preview script re-run against people_clip.mp4 (occupied-cell
# density p90=0.108; stable multi-track frames typically peaked ~0.11-0.18).
DENSITY_CONGESTION_THRESHOLD=0.1

# Flow magnitude (true pixels/second) at or below which a cell counts as
# "low flow" for Congestion — the other required half of the density-AND-
# low-flow combination.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 40.0, informed by the same real preview re-run
# (occupied-cell speed p25=28.0 px/s; whole-grid speed p25=37.6 px/s).
FLOW_MAGNITUDE_CONGESTION_THRESHOLD_PX_PER_SEC=40.0

# Bottleneck: number of recent FlowGridField snapshots kept in the rolling
# window used for tracer advection (a frame-count/temporal-horizon choice,
# not a pixel-space quantity).
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 30 (~1s at people_clip.mp4's 30fps), the spec's own
# suggested starting point.
BOTTLENECK_WINDOW_FRAMES=30

# Reverse Flow: EMA decay rate for each grid cell's learned baseline
# direction (higher = faster adaptation). Angle-based; not a pixel-space
# quantity.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 0.1, the spec's own suggested default.
REVERSE_FLOW_BASELINE_EMA_ALPHA=0.1

# Reverse Flow: minimum motion observations a cell must accumulate before
# its baseline is trusted enough to check for reverse flow at all.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 15, the spec's own suggested default.
REVERSE_FLOW_MIN_BASELINE_OBSERVATIONS=15

# Reverse Flow: angular deviation (degrees) from a cell's baseline beyond
# which a single frame counts as "locally reversed." Angle-based; not a
# pixel-space quantity.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 120.0, the spec's own suggested default.
REVERSE_FLOW_DEVIATION_THRESHOLD_DEGREES=120.0

# Reverse Flow: size (in frames) of the rolling boolean window of "locally
# reversed" flags kept per cell for the temporal-persistence check.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 10, the spec's own suggested default.
REVERSE_FLOW_PERSISTENCE_WINDOW_FRAMES=10

# Reverse Flow: minimum number of "locally reversed" frames within the
# persistence window required before is_reverse_flow is actually set True.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 6, the spec's own suggested default.
REVERSE_FLOW_PERSISTENCE_MIN_COUNT=6

# Risk Score: reference max_pressure (pixel-space units, see DECISIONS.md) at
# which the pressure sub-score saturates at 100. Worst-case-sensitive by
# design (uses max_pressure, not mean).
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 100.0, informed by real observed max_pressure values
# from Phase 9's preview re-run against people_clip.mp4 (p95=89.5, max=262.8).
PRESSURE_SCORE_REFERENCE_PX=100.0

# Risk Score: weighted-average weights combining the four sub-scores
# (pressure/congestion/bottleneck/reverse_flow) into risk_score. MUST sum to
# 1.0 (validated at settings load time — a config error is raised otherwise).
# When a sub-score is unavailable, its weight is redistributed proportionally
# among the others at RUNTIME, not by editing these values.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): pressure=0.5 (largest, per §12), congestion=0.2,
# bottleneck=0.2, reverse_flow=0.1 (smallest, least-validated mechanism).
RISK_SCORE_WEIGHT_PRESSURE=0.5
RISK_SCORE_WEIGHT_CONGESTION=0.2
RISK_SCORE_WEIGHT_BOTTLENECK=0.2
RISK_SCORE_WEIGHT_REVERSE_FLOW=0.1

# Predictive Projection: rolling TIME window (seconds, not frame count) of
# recent (timestamp, mean_pressure) pairs used to fit the linear trend.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 10.0, the spec's own suggested default.
PREDICTIVE_WINDOW_SECONDS=10.0

# Predictive Projection: how far forward (real seconds) to extrapolate the
# linear trend. DELIBERATELY NOT the problem statement's "10 minutes before"
# figure — see predictive_projection.py's module docstring and DECISIONS.md;
# that is a system-level goal achieved via sustained trend detection over
# time (a later phase), not a literal guarantee from this single-window fit.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 30.0, the spec's own suggested default.
PREDICTION_HORIZON_SECONDS=30.0

# Heatmaps: DensityField.grid value (people/cell) that maps to full-scale
# ("hottest") heatmap color.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 0.2, informed by real observed max_density values from a
# Phase 9 preview re-run against people_clip.mp4, restricted to full-
# confidence (non-degraded) frames only (max never exceeded ~0.18 on this
# sparse video).
DENSITY_HEATMAP_REFERENCE_COUNT=0.2

# Filesystem path where rendered heatmap JPEGs are stored.
HEATMAP_STORAGE_PATH=storage/heatmaps

# Vision Intelligence (Phase 14): Ollama model tag for MiniCPM-V 4.6 at the
# Q4_K_M quantization tier — verified to exist (ollama.com/library/
# minicpm-v4.6/tags) and verified pulled/runnable in this project's dev
# environment (`ollama list`). Was a Phase 1 placeholder ("placeholder-vlm"),
# genuinely activated for the first time in Phase 14. See DECISIONS.md for
# the full Ollama-over-raw-llama-cpp-python-bindings and version-selection
# reasoning.
VLM_MODEL=minicpm-v4.6:q4_K_M

# Decision Intelligence (Phase 17): Ollama model tag for Qwen3-8B —
# verified to exist (ollama.com/library/qwen3/tags) and verified pulled/
# runnable in this project's dev environment (`ollama list`). Was a Phase 1
# placeholder ("placeholder-llm"), genuinely activated for the first time in
# Phase 17. A newer "Qwen3.5" family also exists on Ollama as of this
# phase — deliberately NOT used, per §8/§17/§40's explicit "Qwen3-8B" pin;
# see DECISIONS.md.
LLM_MODEL=qwen3:8b

# Base URL of the locally-running Ollama daemon (Phase 14). Ollama's own
# default port.
OLLAMA_BASE_URL=http://localhost:11434

# Vision Intelligence (Phase 14, ROI selection decision #1): the argmax
# risk-grid cell's own pixel footprint is expanded by this factor (uniformly
# around its center) before being sent as the VLM's zoomed ROI crop.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 3.0, a reasonable round multiplier, not tuned against
# any real "was this crop actually useful to the VLM" evaluation.
ROI_EXPANSION_FACTOR=3.0

# Vision Intelligence (Phase 14, decision #5): if the model's response fails
# schema validation, retry this many times before raising
# VLMResponseValidationError.
VLM_MAX_RETRIES=2

# Vision Intelligence (Phase 14, decision #6): seconds to wait for a single
# Ollama chat call before treating it as unavailable (VLMUnavailableError).
# Local CPU VLM inference can be slow, so this is deliberately generous.
VLM_REQUEST_TIMEOUT_SECONDS=60.0

# Vision Intelligence (Phase 14, decision #7): sampling temperature for
# schema-constrained structured output. Low but not exactly 0.0 (some
# models exhibit degenerate repetition at exactly 0), per Ollama's own
# documented recommendation for structured outputs.
VLM_TEMPERATURE=0.15

# Risk State (Phase 13): Phase 11's risk_score (0-100 scale, NOT raw
# pixel-space Crowd Pressure — see risk_state.py's Resolution 1) threshold
# above which a SUSTAINED, HYSTERESIS-CONFIRMED transition moves NORMAL ->
# ELEVATED. Was a 0-1-scale Phase 1 placeholder, never actually consumed
# until this phase.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 40.0, informed by a real preview re-run of
# scripts/preview_risk_score_projection.py against people_clip.mp4 (149
# frame-pairs; risk_score p90=39.31, p95=47.12, max=53.37, mean=15.50) —
# sits just above the real observed p90 on this sparse, low-risk video.
RISK_ELEVATED_THRESHOLD=40.0

# Risk State (Phase 13): risk_score threshold above which a sustained
# transition moves ELEVATED -> CRITICAL.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 65.0, sits ABOVE the real observed max (53.37) on
# people_clip.mp4 — genuine CRITICAL requires conditions worse than
# anything seen on this calm, sparse footage.
RISK_CRITICAL_THRESHOLD=65.0

# Risk State (Phase 13): risk_score level at which, once sustained while
# ALREADY CRITICAL, the diagnostic `incident_threshold_crossed` flag is set
# (decision #4). Does NOT drive any state transition this phase (see
# Resolution 2 — INCIDENT is unreachable) — informational metadata only,
# for a future Decision Intelligence phase to consume.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 85.0. No real "genuine crush incident" ground truth
# exists yet to calibrate against; set well above RISK_CRITICAL_THRESHOLD.
RISK_INCIDENT_THRESHOLD=85.0

# Risk State (Phase 13, decision #1): shared FALL-threshold hysteresis
# margin — each rise threshold's fall counterpart is (rise_threshold - this
# margin), rather than 3 independently-tunable fall thresholds (a
# deliberate simplification of §40's plural "hysteresis margins" wording).
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 10.0, informed by real observed frame-to-frame
# risk_score volatility on the same people_clip.mp4 preview re-run (mean
# absolute delta ~9.58 across 148 consecutive frame-pairs) — sits just
# above that real observed noise floor so ordinary single-frame jitter
# alone cannot cross both a rise and its fall threshold.
RISK_STATE_FALL_HYSTERESIS_MARGIN=10.0

# Risk State (Phase 13, decision #2): number of CONSECUTIVE update() calls
# a candidate rise/fall condition must hold before a transition is
# confirmed. A single anomalous frame must never trigger escalation (§14).
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 30 frames (~1s at people_clip.mp4's 30fps), the same
# "~1s at 30fps" reasoning already used for BOTTLENECK_WINDOW_FRAMES.
RISK_STATE_PERSISTENCE_FRAMES=30

# Minimum seconds between consecutive RISK-trigger firings at the SAME
# severity level (Phase 13, decision #6) — a genuinely HIGHER escalation
# during the cooldown window overrides it. Phase 1 placeholder, genuinely
# activated for the first time in Phase 13; no VLM exists yet to
# empirically tune this against.
VLM_COOLDOWN=30

# Seconds between FALLBACK trigger firings — independent of risk state
# (Phase 13, decision #7), a periodic baseline check regardless of whether
# risk ever escalates. Phase 1 placeholder, genuinely activated for the
# first time in Phase 13; no VLM cost model exists yet to optimize against.
FALLBACK_ANALYSIS_INTERVAL=60

# Evidence Package (Phase 16, decision #5): filesystem path where
# representative-frame and ROI-crop images backing each persisted
# EvidencePackage are stored. First persistence of these image types to disk
# (Phase 14's VLM calls were purely in-memory).
EVIDENCE_FRAMES_STORAGE_PATH=storage/evidence_frames

# Decision Intelligence (Phase 17, decision #7): if the LLM's response fails
# schema/business-rule validation, retry this many times before raising
# LLMResponseValidationError. Mirrors VLM_MAX_RETRIES.
LLM_MAX_RETRIES=2

# Decision Intelligence (Phase 17, decision #7): seconds to wait for a
# single Ollama chat call before treating it as unavailable
# (LLMUnavailableError). Mirrors VLM_REQUEST_TIMEOUT_SECONDS, slightly
# higher default (Qwen3-8B is a larger model than MiniCPM-V's Q4_K_M tier).
LLM_REQUEST_TIMEOUT_SECONDS=90.0

# Decision Intelligence (Phase 17, decision #7): sampling temperature for
# schema-constrained structured decision output. Mirrors VLM_TEMPERATURE.
LLM_TEMPERATURE=0.15

# Decision Intelligence (Phase 17, decision #4): confidence floor AT OR
# BELOW which should_abstain() short-circuits to ABSTAIN without calling
# the LLM at all (inclusive "<=" comparison — the floor value itself also
# triggers abstention, not just values strictly below it).
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 0.4, matching density.py's own
# TOO_FEW_POINTS_CONFIDENCE tier (the worst systematic density-estimation
# confidence this pipeline ever emits) — cross-checked against the two real
# EvidencePackage rows persisted by Phase 16's preview script (both
# confidence=0.5, one degradation tier above this floor).
DECISION_CONFIDENCE_FLOOR=0.4

# Verifier (Phase 18, decision #7 pattern): if the model's response fails
# schema validation, retry this many times before raising
# LLMVerificationResponseValidationError. Mirrors LLM_MAX_RETRIES.
VERIFIER_MAX_RETRIES=2

# Verifier (Phase 18, Step 0): seconds to wait for a single Ollama chat
# call before treating it as unavailable (LLMVerificationUnavailableError).
# NOT reused from LLM_REQUEST_TIMEOUT_SECONDS (measured for the Reasoner's
# faster think=False path) — measured directly against the Verifier's own
# real think=True prompt.
#
# REAL DATA (not guessed — see DECISIONS.md's "Step 0: Real Verifier
# Latency Measurement" entry): 5 real think=True calls against a real
# Phase 17 EvidencePackage+DecisionResult pair measured 213.50s, 199.28s,
# 182.83s, 187.12s, 177.76s (max=213.50s). Per Step 0's instruction:
# observed maximum + 20% safety margin = 213.50 * 1.2 = 256.20, rounded up.
VERIFIER_REQUEST_TIMEOUT_SECONDS=260.0

# Verifier (Phase 18, Step 0 item 5): Ollama's options.num_predict — bounds
# TOTAL generated tokens (thinking + final content combined). A GENEROUS
# backstop against pathological runaway generation, not an active
# constraint under normal operation.
#
# REAL DATA: observed eval_count across 5 real think=True calls ranged
# 184-253 tokens; a dedicated confirmation call with num_predict=1000 set
# completed normally (173.53s, valid high-quality output, used only 203
# tokens) — confirming this cap does not truncate or degrade real output.
VERIFIER_MAX_THINKING_TOKENS=1000

# Incident Manager (Phase 19, decision #2): a new incident-worthy decision
# correlates into an existing DETECTED/ACTIVE incident for the SAME session
# if its timestamp is within this many seconds of that incident's most
# recently linked evidence; otherwise a new incident is created.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 120.0 (2 minutes), informed by VLM_COOLDOWN=30s (a
# sustained incident's successive evidence cycles naturally arrive at
# least ~30s apart) — a ~4x margin over that floor. Known, honest MVP
# limitation: single-camera, time-only correlation, not zone-topology
# cross-camera correlation.
INCIDENT_CORRELATION_WINDOW_SECONDS=120.0

# AnalysisOrchestrator (Phase 20, Decision B): how many Loop B (VLM ->
# EvidenceBuilder -> Reasoner -> [Verifier] -> Incident correlation) chains
# may run CONCURRENTLY for one session. A trigger that fires while the cap
# is reached is DROPPED (not queued), with a logged reason.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 1, the spec's own suggested default — Ollama competes
# for the same CPU cores Loop A needs on this single-CPU-box MVP target.
MAX_CONCURRENT_SEMANTIC_ANALYSES=1

# AnalysisOrchestrator (Phase 20, Decision F/G): how many Loop A frames
# between each periodic checkpoint (cancellation check, progress-column
# update, heatmap-due check) — one shared cadence for all three concerns.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 30, the spec's own suggested default (~1s at
# people_clip.mp4's 30fps).
PROGRESS_UPDATE_INTERVAL_FRAMES=30

# AnalysisOrchestrator (Phase 20, Decision H, resolving Phase 12's deferred
# cadence question): minimum VIDEO-TIMELINE seconds between heatmap
# generation events, checked at the same periodic checkpoint as above.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 5.0 seconds, informed by §24's "timestamp-synchronized
# display" wanting a reasonably dense, scrubbable timeline.
HEATMAP_GENERATION_INTERVAL_SECONDS=5.0

# JSON array of allowed CORS origins for the backend API
CORS_ORIGINS=["http://localhost:3000"]
