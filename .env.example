# PostgreSQL connection string (postgresql+psycopg2://user:password@host:port/dbname)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/crowdshield

# PostgreSQL connection string for the dedicated test database (used by backend/tests/conftest.py)
DATABASE_URL_TEST=postgresql+psycopg2://user:password@localhost:5432/crowdshield_test

# Secret key used by Auth.js (frontend) to encrypt/sign its own session — NOT used by the backend
AUTH_SECRET=changeme

# Secret key used by FastAPI to sign/verify its own JWTs. Independent of AUTH_SECRET — never reuse
# Auth.js's secret here. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=changeme

# Minutes until a FastAPI-issued JWT access token expires
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Public URL of the Next.js frontend, used by Auth.js
NEXTAUTH_URL=http://localhost:3000

# Filesystem path where uploaded/processed video files are stored
VIDEO_STORAGE_PATH=storage/videos

# Maximum accepted video upload size, in megabytes. Enforced while streaming
# to disk (not just via Content-Length), so oversized uploads are aborted and
# the partial file deleted before this limit is exceeded.
MAX_UPLOAD_SIZE_MB=2048

# Application log verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Name/identifier of the object detection model used by the pipeline
DETECTOR_MODEL=yolo11n

# Inference backend for the detector: "pytorch" is the only implemented
# value; "openvino" is deferred to roadmap Phase 23 (CPU optimization) and
# will raise a clear configuration error if set today. Note: this does NOT
# select the compute device — YOLO11nDetector always forces CPU inference
# regardless of this setting (master spec §5's CPU-first constraint).
DETECTOR_RUNTIME=pytorch

# Minimum confidence for a detection to be kept, passed directly to
# ultralytics' conf= inference parameter (also governs its internal NMS).
# 0.25 matches ultralytics' own library default.
DETECTOR_CONFIDENCE_THRESHOLD=0.25

# How many of a track's most recent positions are kept in memory per track
# (bounded history, ~1s at 30fps). May need retuning once the Crowd
# Intelligence Engine's actual velocity-variance windowing needs are known.
TRACK_HISTORY_LENGTH=30

# trackers.ByteTrackTracker's lost_track_buffer: number of 30fps-equivalent
# frames a track is retained after going unmatched before being permanently
# removed. 30 is the library's own default.
TRACKER_LOST_TRACK_BUFFER=30

# trackers.ByteTrackTracker's minimum_consecutive_frames: number of
# consecutive matched frames required before a new track is confirmed (given
# a stable track_id instead of the library's placeholder -1). 2 is the
# library's own default.
TRACKER_MINIMUM_CONSECUTIVE_FRAMES=2

# trackers.ByteTrackTracker's track_activation_threshold: minimum detection
# confidence required to CREATE a new track (distinct from
# DETECTOR_CONFIDENCE_THRESHOLD, which gates what counts as a detection at
# all). The library's own general-purpose default is 0.7, but real-footage
# testing found that most real detections from YOLO11nDetector (tuned to
# 0.25 for recall) never clear 0.7, so almost no one gets a confirmed
# track_id at that default in dense/aerial scenes.
#
# UNVALIDATED ENGINEERING JUDGMENT (not empirically tuned against real
# crowd footage, candidate for Sprint-0 recalibration — see DECISIONS.md):
# 0.3, chosen just above DETECTOR_CONFIDENCE_THRESHOLD's 0.25 floor.
TRACKER_TRACK_ACTIVATION_THRESHOLD=0.3

# Which cv2.DISOpticalFlow_create preset to use: "ultrafast", "fast", or
# "medium" (mapped to the real cv2.DISOPTICAL_FLOW_PRESET_* constants).
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): "fast", a balance between quality and CPU cost per §5's
# own "~21-48 FPS depending on preset" citation; not benchmarked on this
# project's target hardware.
DIS_PRESET=fast

# Flow-magnitude floor (pixels) below which a pixel is excluded from this
# phase's whole-frame summary statistics only — the raw flow field itself is
# never filtered.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 0.5.
MOTION_MAGNITUDE_NOISE_FLOOR=0.5

# Pixels per square grid cell edge for the shared spatial grid Density and
# Flow are both computed on (so Crowd Pressure can combine them pointwise
# without interpolation). Grid rows/cols are derived from frame width/height
# divided by this value.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 40, not calibrated against any real venue's physical
# scale (this project has no camera calibration — see DECISIONS.md's "Known
# Structural Limitation: Pixel-Space vs. Real-World Units" section).
CROWD_GRID_CELL_SIZE_PX=40

# Density (people/cell) threshold above which a cell counts as "dense" for
# Congestion — used ONLY in combination with the flow-magnitude threshold
# below (density alone never triggers congestion; frozen decision).
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 0.1, informed by real observed density values from
# Phase 9's preview script re-run against people_clip.mp4 (occupied-cell
# density p90=0.108; stable multi-track frames typically peaked ~0.11-0.18).
DENSITY_CONGESTION_THRESHOLD=0.1

# Flow magnitude (true pixels/second) at or below which a cell counts as
# "low flow" for Congestion — the other required half of the density-AND-
# low-flow combination.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 40.0, informed by the same real preview re-run
# (occupied-cell speed p25=28.0 px/s; whole-grid speed p25=37.6 px/s).
FLOW_MAGNITUDE_CONGESTION_THRESHOLD_PX_PER_SEC=40.0

# Bottleneck: number of recent FlowGridField snapshots kept in the rolling
# window used for tracer advection (a frame-count/temporal-horizon choice,
# not a pixel-space quantity).
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 30 (~1s at people_clip.mp4's 30fps), the spec's own
# suggested starting point.
BOTTLENECK_WINDOW_FRAMES=30

# Reverse Flow: EMA decay rate for each grid cell's learned baseline
# direction (higher = faster adaptation). Angle-based; not a pixel-space
# quantity.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 0.1, the spec's own suggested default.
REVERSE_FLOW_BASELINE_EMA_ALPHA=0.1

# Reverse Flow: minimum motion observations a cell must accumulate before
# its baseline is trusted enough to check for reverse flow at all.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 15, the spec's own suggested default.
REVERSE_FLOW_MIN_BASELINE_OBSERVATIONS=15

# Reverse Flow: angular deviation (degrees) from a cell's baseline beyond
# which a single frame counts as "locally reversed." Angle-based; not a
# pixel-space quantity.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 120.0, the spec's own suggested default.
REVERSE_FLOW_DEVIATION_THRESHOLD_DEGREES=120.0

# Reverse Flow: size (in frames) of the rolling boolean window of "locally
# reversed" flags kept per cell for the temporal-persistence check.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 10, the spec's own suggested default.
REVERSE_FLOW_PERSISTENCE_WINDOW_FRAMES=10

# Reverse Flow: minimum number of "locally reversed" frames within the
# persistence window required before is_reverse_flow is actually set True.
#
# UNVALIDATED ENGINEERING JUDGMENT (candidate for Sprint-0 recalibration —
# see DECISIONS.md): 6, the spec's own suggested default.
REVERSE_FLOW_PERSISTENCE_MIN_COUNT=6

# Name/identifier of the vision-language model used for scene analysis
VLM_MODEL=placeholder-vlm

# Name/identifier of the large language model used for decision support
LLM_MODEL=placeholder-llm

# Crowd density/risk score threshold that triggers an "elevated" status
RISK_ELEVATED_THRESHOLD=0.5

# Crowd density/risk score threshold that triggers a "critical" status
RISK_CRITICAL_THRESHOLD=0.75

# Crowd density/risk score threshold that triggers an "incident" status
RISK_INCIDENT_THRESHOLD=0.9

# Minimum seconds between consecutive VLM analysis calls
VLM_COOLDOWN=30

# Seconds between fallback (non-VLM) analysis passes when VLM is unavailable
FALLBACK_ANALYSIS_INTERVAL=60

# JSON array of allowed CORS origins for the backend API
CORS_ORIGINS=["http://localhost:3000"]
